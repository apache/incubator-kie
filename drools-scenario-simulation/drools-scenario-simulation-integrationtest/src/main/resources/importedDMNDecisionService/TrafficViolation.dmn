  <decision id="_EDD8A074-A7C9-41EE-A686-C135C5CF9E61" name="Should the driver be suspended?">
    <extensionElements />
    <question>Should the driver be suspended due to points on his license?</question>
    <allowedAnswers>&quot;Yes&quot;, &quot;No&quot;</allowedAnswers>
    <variable id="_A9342BBF-D283-43D4-A2D7-AC957B9EDC46" name="Should the driver be suspended?" typeRef="string" />
    <informationRequirement id="_8BE0394D-1B87-4DDB-BD77-0BCAE2555260">
      <requiredInput href="#_BBC64A18-6D72-448E-8780-860EECF45BD2" />
    </informationRequirement>
    <informationRequirement id="_C90833DE-75AA-4DE4-A372-182E3B2A4EEC">
      <requiredDecision href="#_953B89D5-5DEC-41F0-BE4C-5E9CF47F5046" />
    </informationRequirement>
    <informationRequirement id="_BC4EA161-10E5-4C92-9DE5-5A4B6279011F">
      <requiredInput href="#_D2ED414D-4ECC-466B-8CBF-BF3BE891B0EA" />
    </informationRequirement>
    <knowledgeRequirement id="_4F7EE2F2-FFE9-4AA4-A00A-CC367BCAED8D">
      <requiredKnowledge href="https://kie.org/dmn/_D100CBD0-5691-43FC-8EBD-06B2DFA56BC9#_0666BBFF-AD2A-4614-9FFC-8C707B05A570" />
    </knowledgeRequirement>
    <context id="_A7DF6DB5-110D-49EE-8307-D8C0B166EFB3" label="Should the driver be suspended?" typeRef="string">
      <contextEntry id="_78B865AF-7BBE-4A0E-8856-B16D98BE1662">
        <variable id="_07004E15-D99A-4F10-87EB-94BF3EAD99B3" name="Total Points" typeRef="number" />
        <literalExpression id="_4E9BF5BB-1AC2-448E-823A-D6BB1D3521FA">
          <text>Driver.Points + Fine.Points</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="_FDA74E50-971E-4ED3-B2D6-0DF4F47E1939">
        <variable id="_D9B5CFDC-29AC-443D-9198-F5E17CCD4402" name="has strict rules" typeRef="boolean">
          <description></description>
        </variable>
        <literalExpression id="_F6BCC034-7CF6-47F5-8758-7B39FAE17B09" typeRef="boolean" label="has strict rules">
          <text>grds.GeneralRulesDecisionService(Country)</text>
        </literalExpression>
      </contextEntry>
      <contextEntry id="_ED327B94-0594-4D37-BD24-72B338F01446">
        <literalExpression id="_4AFDD452-CAA2-4BC6-B623-E817ED16E4FE">
          <text>if (Total Points &gt;= 20 and has strict rules) or (Total Points &gt;= 30) then &quot;Yes&quot; else &quot;No&quot; </text>
        </literalExpression>
      </contextEntry>
    </context>
  </decision>
