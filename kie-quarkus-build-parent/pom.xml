<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.kie</groupId>
    <artifactId>drools-build-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <relativePath>../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>kie-quarkus-build-parent</artifactId>
  <packaging>pom</packaging>

  <name>Kie Quarkus :: Build Parent</name>
  <description>
   Build parent for all kie+quarkus projects
  </description>

  <properties>
    <!-- CVE-2026-111497 (GHSA-9v8h-qqgm-4m35): quarkus-bom:3.33.4.1 ships brotli4j and native artifacts
         at 1.23.0 (vulnerable out-of-bounds write in Google Brotli decoder). Pin brotli4j and all native
         architecture variants to 1.24.0 before quarkus-bom import so CI/production (Linux x86_64) and
         developer environments (macOS/Windows) resolve the secure release.
         Remove when quarkus-bom ships brotli4j >= 1.24.0. -->
    <version.com.aayushatharva.brotli4j>1.24.0</version.com.aayushatharva.brotli4j>
    <!--
      [CVE-2026-45292, CVE-2026-118259 (GHSA-ccrj-gw8r-854m)] opentelemetry-api: prior pin was 1.62.0
      (CVE-2026-45292 fix). Versions 1.62.0-1.66.0 are vulnerable to quadratic CPU consumption in
      W3C tracestate parsing (CVE-2026-118259). Pin to 1.67.0 (first CVE-free same-major release).
      MUST move in lockstep with version.io.opentelemetry.instrumentation below: 1.67.0 removed
      io.opentelemetry.api.internal.ConfigUtil, which opentelemetry-api-incubator 1.62.0-1.66.0-alpha
      still calls (NoClassDefFoundError at startup of any app using smallrye-reactive-messaging-kafka).
      Should be removed in future Quarkus upgrades that include OpenTelemetry >= 1.67.0
    -->
    <version.io.opentelemetry.api>1.67.0</version.io.opentelemetry.api>
    <!--
      opentelemetry-instrumentation-bom-alpha imports opentelemetry-bom and opentelemetry-bom-alpha, which
      control opentelemetry-api-incubator, -sdk and -context. 2.28.1-alpha imports 1.62.0, which mismatches
      the opentelemetry-api 1.67.0 pin above; 2.33.0-alpha imports 1.67.0 / 1.67.0-alpha.
      Remove together with version.io.opentelemetry.api once quarkus-bom ships OpenTelemetry >= 1.67.0
    -->
    <version.io.opentelemetry.instrumentation>2.33.0-alpha</version.io.opentelemetry.instrumentation>
    <version.io.quarkus>3.33.4.1</version.io.quarkus>
    <version.io.quarkus.camel>3.33.3</version.io.quarkus.camel>
    <!-- Quarkus-platform-aligned pin. kie-parent keeps the Spring Boot / framework-neutral value;
         this tree needs the platform one (smallrye-reactive-messaging 4.33.0 requires Mutiny 3). -->
    <version.io.smallrye.mutiny>3.1.1</version.io.smallrye.mutiny>
    <version.io.smallrye.reactive.messaging.in.memory>4.33.0</version.io.smallrye.reactive.messaging.in.memory>
    <!-- Quarkus 3.33 platform pins (same as kogito-quarkus/bom; this tree does not inherit it). kie-parent keeps the
         framework-neutral values. smallrye-config 3.16 and jandex 3.5 are hard requirements; open-api 4.2.4 needs jandex 3.5. -->
    <version.io.smallrye-config>3.16.0</version.io.smallrye-config>
    <version.io.smallrye.config.core>3.16.0</version.io.smallrye.config.core>
    <version.io.smallrye.jandex>3.5.3</version.io.smallrye.jandex>
    <version.io.smallrye-open-api>4.2.4</version.io.smallrye-open-api>
    <version.io.smallrye.openapi.core>4.2.4</version.io.smallrye.openapi.core>
    <!-- Used to define which poms are allowed to have dependencyManagement sections. This is to enforce the convention that only the root pom should have dependencyManagement, and all other poms should inherit from it. -->
    <allowedPomsList>org.kie:kie-quarkus-build-parent</allowedPomsList>
    <!-- To be overridden by poms with dependency management -->
    <root_pom>../pom.xml</root_pom>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- CVE-2026-111497 (GHSA-9v8h-qqgm-4m35): quarkus-bom:3.33.4.1 pins brotli4j and native
           artifacts at 1.23.0 (vulnerable out-of-bounds write in Google Brotli decoder).
           All architecture variants (native-linux-*, native-osx-*, native-windows-*, service)
           are pinned together to ensure both Linux CI/production builds and local developer
           workstations (macOS/Windows) resolve secure 1.24.0 artifacts.
           These entries must appear before the quarkus-bom import — first declaration wins in Maven
           dependencyManagement. Remove when quarkus-bom ships brotli4j >= 1.24.0. -->
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>brotli4j</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-aarch64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-armv7</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-ppc64le</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-riscv64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-s390x</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-linux-x86_64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-osx-aarch64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-osx-x86_64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-windows-aarch64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>native-windows-x86_64</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>com.aayushatharva.brotli4j</groupId>
        <artifactId>service</artifactId>
        <version>${version.com.aayushatharva.brotli4j}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
        <version>${version.io.opentelemetry.instrumentation}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-api</artifactId>
        <version>${version.io.opentelemetry.api}</version>
      </dependency>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.io.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-quarkus-integration-test-multimodule-dep</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-quarkus-ruleunits</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-quarkus-ruleunits-deployment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-quarkus-util-deployment</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>