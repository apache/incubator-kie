        <bpmn2:boundaryEvent id="userTaskBoundary" attachedToRef="userTask">
          <bpmn2:signalEventDefinition signalRef="sig_CancelTask" />
        </bpmn2:boundaryEvent>
        <bpmn2:sequenceFlow id="sf_innerStart_userTask" sourceRef="innerStart" targetRef="userTask" />
        <bpmn2:sequenceFlow id="sf_userTask_innerEnd" sourceRef="userTask" targetRef="innerEnd" />
        <bpmn2:sequenceFlow id="sf_boundary_handlerTask" sourceRef="userTaskBoundary" targetRef="handlerTask" />
        <bpmn2:sequenceFlow id="sf_handlerTask_handlerEnd" sourceRef="handlerTask" targetRef="handlerEnd" />
      </bpmn2:subProcess>
      <bpmn2:sequenceFlow id="sf_outerStart_innerSub" sourceRef="outerStart" targetRef="innerSub" />
      <bpmn2:sequenceFlow id="sf_innerSub_outerEnd" sourceRef="innerSub" targetRef="outerEnd" />
    </bpmn2:subProcess>
    <bpmn2:sequenceFlow id="sf_start_outerSub" sourceRef="processStart" targetRef="outerSub" />
    <bpmn2:sequenceFlow id="sf_outerSub_processEnd" sourceRef="outerSub" targetRef="processEnd" />
  </bpmn2:process>
