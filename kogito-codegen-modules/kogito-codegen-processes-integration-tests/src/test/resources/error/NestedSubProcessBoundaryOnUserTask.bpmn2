  <bpmn2:signal id="sig_CancelTask" name="CancelTask" />
  <bpmn2:process id="NestedSubProcessBoundaryOnUserTask" drools:packageName="com.example" drools:version="1.0" drools:adHoc="false" name="NestedSubProcessBoundaryOnUserTask" isExecutable="true" processType="Public">
    <bpmn2:startEvent id="processStart" name="Start">
      <bpmn2:outgoing>sf_start_outerSub</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="processEnd">
      <bpmn2:incoming>sf_outerSub_processEnd</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:subProcess id="outerSub" name="OuterSubProcess">
