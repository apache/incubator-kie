      <bpmn2:incoming>sf_start_outerSub</bpmn2:incoming>
      <bpmn2:outgoing>sf_outerSub_processEnd</bpmn2:outgoing>
      <bpmn2:startEvent id="outerStart">
        <bpmn2:outgoing>sf_outerStart_innerSub</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:endEvent id="outerEnd">
