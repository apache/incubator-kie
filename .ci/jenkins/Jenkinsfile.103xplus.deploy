// 10.3.x+ deploy pipeline — no kogito-pipelines dependency.
//   - agent { label 'ubuntu' } + tools block instead of docker { image AGENT_DOCKER_BUILDER_IMAGE }
//   - Maven invoked directly (no MavenCommand shared-library helper)
//   - PR creation via 'gh' CLI instead of githubscm shared-library helpers
//   - @Library removed entirely

deployProperties = [:]
prBranchHash     = ''

pipeline {
    agent {
        label 'ubuntu'
    }

    tools {
        maven 'maven_3.9.16'
        jdk   'jdk_17_latest'
    }

    options {
        timestamps()
        timeout(time: 300, unit: 'MINUTES')
    }

    environment {
        DROOLS_CI_EMAIL_TO = credentials("${JENKINS_EMAIL_CREDS_ID}")
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    cleanWs(disableDeferredWipeout: true)

                    prBranchHash = sh(script: 'openssl rand -hex 5', returnStdout: true).trim()

                    if (params.DISPLAY_NAME) {
                        currentBuild.displayName = params.DISPLAY_NAME
                    }

                    if (isCreatePr()) {
                        assert getProjectVersion() : 'PROJECT_VERSION is required when CREATE_PR is true'
                    }

                    dir(getRepoName()) {
                        checkoutRepo()
                    }
                }
            }
            post {
                success {
                    script {
                        setDeployPropertyIfNeeded('git.branch', getBuildBranch())
                        setDeployPropertyIfNeeded('git.author', getGitAuthor())
                        setDeployPropertyIfNeeded('project.version', getProjectVersion())
                    }
                }
            }
        }

        stage('Prepare for PR') {
            when {
                expression { return isCreatePr() }
            }
            steps {
                script {
                    dir(getRepoName()) {
                        withCredentials([usernamePassword(credentialsId: getGitAuthorPushCredsId(), usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            sh """#!/usr/bin/env bash
                            set -euo pipefail
                            git config user.email "${env.GIT_AUTHOR_EMAIL ?: 'dev@kie.apache.org'}"
                            git config user.name  "${env.GIT_AUTHOR ?: 'Apache KIE Release Bot'}"
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'
                            if git ls-remote --exit-code origin '${getPRBranch()}'; then
                                git push origin --delete '${getPRBranch()}' || true
                            fi
                            git checkout -b '${getPRBranch()}'
                            """
                        }
                    }
                }
            }
        }

        stage('Update project version') {
            when {
                expression { return getProjectVersion() }
            }
            steps {
                script {
                    dir(getRepoName()) {
                        configFileProvider([configFile(fileId: env.MAVEN_SETTINGS_CONFIG_FILE_ID, variable: 'MAVEN_SETTINGS_FILE')]) {
                            def snapshotFlag = isStreamDevVersion() ? '' : '-DgenerateBackupPoms=false'
                            sh """#!/usr/bin/env bash
                            set -euo pipefail
                            mvn -s "\${MAVEN_SETTINGS_FILE}" -B -ntp \
                                versions:set \
                                -DnewVersion='${getProjectVersion()}' \
                                ${snapshotFlag}
                            """
                        }
                    }
                }
            }
        }

        stage('Build & Deploy repo') {
            steps {
                script {
                    dir(getRepoName()) {
                        configFileProvider([configFile(fileId: env.MAVEN_SETTINGS_CONFIG_FILE_ID, variable: 'MAVEN_SETTINGS_FILE')]) {
                            withCredentials([usernamePassword(credentialsId: env.MAVEN_REPO_CREDS_ID, usernameVariable: 'REPOSITORY_USER', passwordVariable: 'REPOSITORY_TOKEN')]) {
                                def goal
                                if (shouldDeployToRepository()) {
                                    goal = "deploy -DdeployAtEnd -Dapache.repository.username=\${REPOSITORY_USER} -Dapache.repository.password=\${REPOSITORY_TOKEN} -DretryFailedDeploymentCount=5"
                                } else {
                                    goal = 'install'
                                }

                                def extraOpts = [
                                    env.BUILD_MVN_OPTS,
                                    env.DROOLS_BUILD_MVN_OPTS,
                                    env.BUILD_MVN_OPTS_CURRENT
                                ].findAll { it }.join(' ')

                                def skipTestsFlag = params.SKIP_TESTS ? '-DskipTests' : ''

                                sh """#!/usr/bin/env bash
                                set -euo pipefail
                                mvn -s "\${MAVEN_SETTINGS_FILE}" -B -ntp -fae \
                                    -Dfull \
                                    ${skipTestsFlag} \
                                    -Dmaven.test.failure.ignore=true \
                                    ${extraOpts} \
                                    clean ${goal}
                                """
                            }
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        dir(getRepoName()) {
                            saveReports()
                            archiveArtifacts(artifacts: 'build_logs/**', allowEmptyArchive: true)
                        }
                    }
                }
            }
        }

        stage('Create PR') {
            when {
                expression { return isCreatePr() }
            }
            steps {
                script {
                    dir(getRepoName()) {
                        withCredentials([usernamePassword(credentialsId: getGitAuthorPushCredsId(), usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
                            def prLink = sh(script: """#!/usr/bin/env bash
                            set -euo pipefail
                            git config --local credential.helper '!f() { echo username=\$GITHUB_USER; echo password=\$GITHUB_TOKEN; }; f'

                            # Stage only pom.xml and antora.yml changes (version bump files)
                            git add -A -- '*.xml' '*/antora.yml' 2>/dev/null || true
                            if git diff --cached --quiet; then
                                echo '[WARN] no changes to commit' >&2
                                echo ''
                                exit 0
                            fi

                            COMMIT_MSG="[${getBuildBranch()}] Update version to ${getProjectVersion()}"
                            git commit -m "\${COMMIT_MSG}"
                            git push origin '${getPRBranch()}'

                            PR_BODY="Generated by build ${BUILD_TAG}: ${BUILD_URL}.\\nPlease do not merge, it should be merged automatically."
                            gh pr create \
                                --repo '${getGitAuthor()}/${getRepoName()}' \
                                --head '${getPRBranch()}' \
                                --base '${getBuildBranch()}' \
                                --title "\${COMMIT_MSG}" \
                                --body "\${PR_BODY}" \
                                --label 'skip-ci'
                            """, returnStdout: true).trim()

                            if (prLink) {
                                deployProperties["${getRepoName()}.pr.link"] = prLink
                            }
                        }
                    }
                }
            }
            post {
                success {
                    script {
                        setDeployPropertyIfNeeded("${getRepoName()}.pr.source.uri", "https://github.com/${getGitAuthor()}/${getRepoName()}")
                        setDeployPropertyIfNeeded("${getRepoName()}.pr.source.ref", getPRBranch())
                        setDeployPropertyIfNeeded("${getRepoName()}.pr.target.uri", "https://github.com/${getGitAuthor()}/${getRepoName()}")
                        setDeployPropertyIfNeeded("${getRepoName()}.pr.target.ref", getBuildBranch())
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                setDeployPropertyIfNeeded("${getRepoName()}.deploy.build.run", true)
                def propertiesStr = deployProperties.collect { entry -> "${entry.key}=${entry.value}" }.join('\n')
                writeFile(text: propertiesStr, file: PROPERTIES_FILE_NAME)
                archiveArtifacts(artifacts: PROPERTIES_FILE_NAME)
            }
        }
        unsuccessful {
            sendNotification()
        }
        cleanup {
            cleanWs()
        }
    }
}

void saveReports() {
    junit testResults: '**/target/surefire-reports/**/*.xml, **/target/failsafe-reports/**/*.xml, **/target/invoker-reports/**/TEST-*.xml', allowEmptyResults: true
}

void checkoutRepo() {
    deleteDir()
    checkout([$class: 'GitSCM',
        branches: [[name: "*/${getBuildBranch()}"]],
        userRemoteConfigs: [[
            url: "https://github.com/${getGitAuthor()}/${getRepoName()}.git",
            credentialsId: getGitAuthorCredsId()
        ]]
    ])
    sh "git checkout ${getBuildBranch()}"
}

void sendNotification() {
    if (params.SEND_NOTIFICATION) {
        mail(
            to: env.DROOLS_CI_EMAIL_TO,
            subject: "[FAILURE] Deploy [${getBuildBranch()}] Drools - Build ${BUILD_TAG}",
            body: "Deploy pipeline failed.\n\nBuild URL: ${BUILD_URL}"
        )
    } else {
        echo 'No notification sent per configuration'
    }
}

boolean shouldDeployToRepository() {
    return env.MAVEN_DEPLOY_REPOSITORY || getGitAuthor() == 'apache'
}

boolean isCreatePr() {
    return params.CREATE_PR
}

boolean isStreamDevVersion() {
    return getProjectVersion()?.contains('-SNAPSHOT') ?: false
}

String getRepoName() {
    return env.REPO_NAME
}

String getGitAuthor() {
    return "${GIT_AUTHOR}"
}

String getBuildBranch() {
    return params.BUILD_BRANCH_NAME
}

String getProjectVersion() {
    return params.PROJECT_VERSION
}

String getPRBranch() {
    return params.DROOLS_PR_BRANCH ?: "drools-${getProjectVersion()}_${prBranchHash}"
}

String getGitAuthorCredsId() {
    return env.GIT_AUTHOR_CREDS_ID
}

String getGitAuthorPushCredsId() {
    return env.GIT_AUTHOR_PUSH_CREDS_ID ?: env.GIT_AUTHOR_CREDS_ID
}

void setDeployPropertyIfNeeded(String key, def value) {
    if (value) {
        deployProperties[key] = value
    }
}
