    <sequenceFlow id="_7-_8" tns:priority="1" name="loop" sourceRef="_7" targetRef="_8">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_4" language="http://www.java.com/java">return x &lt; 1;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_7-_10" tns:priority="2" name="proceed" sourceRef="_7" targetRef="_10"/>
    <sequenceFlow id="_8-_4" tns:priority="1" sourceRef="_8" targetRef="_4"/>
